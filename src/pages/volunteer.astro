---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h2>Volunteer with us: </h2>
      <p>Want to get involved? Complete our sign-up form below!</p>
			<p>
				Thank you for your support. We look forward to seeing or hearing from you one day!
			</p>
<iframe src="https://docs.google.com/forms/d/e/1FAIpQLScLICsWqtutL45q-q0tsfmgVM9KXHWSyalWLXbWvhjmZbmxsg/viewform?embedded=true" width="640" height="2001" frameborder="0" marginheight="0" marginwidth="0">Loading…</iframe>

			</p>
		</main>
		<Footer />
	</body>
</html>
